__pycache__/
*.pyc

# ПРОИЗВОДНЫЕ КАРТИНКИ ВИТРИНЫ (правило 160). Их рисует scripts/build_metrics.py
# при каждом прогоне и публикует ветка `assets` — в дереве общей ветки им не
# место: суточная сборка правила по пять файлов в день, и слияние #111 упёрлось
# в конфликт ровно по ним.
#
# Список здесь — страховка, а не решение. Решает гейт «производное вернулось в
# дерево» (scripts/check_mechanisms.py): он спрашивает у самой сборки, что она
# рисует, и потому не устареет от новой плитки. Шаблон же придётся дописать
# руками — поэтому он и не единственная защита.
#
# Рукодельные СЮДА НЕ ПОПАДАЮТ и остаются в дереве: header-*, typing-*,
# divider-* меняются реже изменений, а не чаще, и сборка их не рисует.
assets/metrics-*.svg
assets/featured-*.svg
assets/tile-*.svg
